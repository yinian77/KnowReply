# worker 本地联调环境变量示例
# --- Redis：复用 lhplat-redis，队列固定走 db2（与网关缓存的 db1 隔离）---
REDIS_ADDR=127.0.0.1:16479
REDIS_PASSWORD=localdev_only_change_me
REDIS_DB_QUEUE=2

# --- MySQL：复用 lhplat-mysql ---
MYSQL_HOST=127.0.0.1
MYSQL_PORT=13406
MYSQL_USER=knowreply
MYSQL_PASSWORD=knowreply_2026_mysql
MYSQL_DATABASE=knowreply

# --- PostgreSQL + pgvector：自建容器 ---
PG_DSN=postgres://knowreply:knowreply_2026_pg@127.0.0.1:15432/knowreply?sslmode=disable
PG_MAX_CONNS=8
PG_MIN_CONNS=1

# --- 向量化：mock 无需外网；改用真实模型时切 openai 并填 KEY ---
EMBEDDING_PROVIDER=mock
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536
EMBEDDING_BATCH_SIZE=16

# --- 切分：README 约定 300~600 字 ---
CHUNK_MIN_RUNES=300
CHUNK_MAX_RUNES=600

# --- 队列与并发 ---
WORKER_QUEUE=ingest
WORKER_CONCURRENCY=4

# --- 本地文档根目录：source_url 用相对路径时的基准，也是防越权读取的边界 ---
DOC_STORAGE_ROOT=

# --- 检索预览服务（kbapi，内部工具）---
KB_API_ADDR=127.0.0.1:6702
