# 网关本地联调环境变量示例，实测值来自 deploy/docker-compose.yml 与 lhplat 现有实例
APP_ENV=dev
HTTP_ADDR=:6701

# --- MySQL（复用 lhplat-mysql：容器内用 lhplat-mysql:3306，宿主机用 127.0.0.1:13406）---
MYSQL_HOST=127.0.0.1
MYSQL_PORT=13406
MYSQL_USER=knowreply
MYSQL_PASSWORD=knowreply_2026_mysql
MYSQL_DATABASE=knowreply
MYSQL_MAX_OPEN_CONNS=20
MYSQL_MAX_IDLE_CONNS=10

# --- Redis（复用 lhplat-redis：宿主机 127.0.0.1:16479）---
REDIS_ADDR=127.0.0.1:16479
REDIS_PASSWORD=localdev_only_change_me
REDIS_DB_CACHE=1
REDIS_DB_QUEUE=2

# --- 鉴权 ---
JWT_SECRET=dev_only_change_me
JWT_TTL=24h

# --- Node Agent gRPC 地址（P0 后半段接通）---
AGENT_GRPC_ADDR=127.0.0.1:50051

# --- 长连接 ---
WS_READ_LIMIT=65536
HTTP_SHUTDOWN_TIMEOUT=15s
